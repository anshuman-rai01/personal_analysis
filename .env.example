# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000/"

# =============================================================================
# OmniLife RiskLens-Style Assistant Configuration (All Optional)
# =============================================================================

# GEMINI_MODEL: Active Gemini model for tool calling and reasoning.
# Default: "gemini-3.5-flash"
GEMINI_MODEL="gemini-3.6-flash"

# ASSISTANT_RATE_LIMIT_PER_MIN: Sliding-window rate limit per user per minute.
# Default: 20
ASSISTANT_RATE_LIMIT_PER_MIN=20

# ASSISTANT_ALLOW_GUEST_WRITES: Allow unauthenticated guests and demo users to prepare
# record creations and deletions.
# Default: false
# SECURITY RISK NOTICE:
# In OmniLife Studio, guest mode falls back to client-supplied x-guest-uid headers or a shared
# default UID (default_user_101) without cryptographic verification. Setting this to true allows
# any client claiming a guest UID to propose writes and deletions against that dataset.
# Enable ONLY on trusted demonstration environments or local testing.
ASSISTANT_ALLOW_GUEST_WRITES=false

# ASSISTANT_LLM_TIMEOUT_MS: Maximum timeout per individual Gemini SDK call in milliseconds.
# Default: 20000 (20 seconds)
ASSISTANT_LLM_TIMEOUT_MS=20000

# ASSISTANT_REQUEST_DEADLINE_MS: Total end-to-end deadline for an assistant chat request.
# Default: 45000 (45 seconds)
ASSISTANT_REQUEST_DEADLINE_MS=45000
