# =============================================================================
# PostgreSQL Database Configuration
# =============================================================================

# SQL_HOST: PostgreSQL server hostname or IP address (e.g. localhost or 127.0.0.1)
SQL_HOST="localhost"

# SQL_PORT: PostgreSQL server port (default: 5432)
SQL_PORT=5432

# SQL_USER: Application database user for day-to-day CRUD operations
SQL_USER="postgres"

# SQL_PASSWORD: Password for the application database user
SQL_PASSWORD="YOUR_SQL_PASSWORD_HERE"

# SQL_DB_NAME: Application database name
SQL_DB_NAME="omnilife"

# SQL_ADMIN_USER: Administrative PostgreSQL user (used only by scripts/setup-db.ts to bootstrap database creation)
SQL_ADMIN_USER="postgres"

# SQL_ADMIN_PASSWORD: Password for the administrative user (falls back to SQL_PASSWORD if omitted)
SQL_ADMIN_PASSWORD="YOUR_ADMIN_PASSWORD_HERE"

# =============================================================================
# Application & Gemini AI Configuration
# =============================================================================

# GEMINI_API_KEY: Required for Gemini AI API calls. Single key definition.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this application is hosted.
APP_URL="http://localhost:3000/"

# =============================================================================
# OmniLife Assistant Configuration (Optional)
# =============================================================================

# GEMINI_MODEL: Active Gemini model for tool calling and reasoning (default: "gemini-3.5-flash-lite")
GEMINI_MODEL="gemini-3.5-flash-lite"

# ASSISTANT_RATE_LIMIT_PER_MIN: Sliding-window rate limit per user per minute (default: 20)
ASSISTANT_RATE_LIMIT_PER_MIN=20

# FIREBASE_PROJECT_ID: Firebase project ID for server-side ID token verification (defaults to projectId in firebase-applet-config.json)
FIREBASE_PROJECT_ID="omnilife-studio"

# SQL_DB_NAME_TEST: Optional database name used by DB-backed integration tests (e.g. "omnilife").
# When set, test runner executes real PostgreSQL cleanup and isolation suites against this database.
# SQL_DB_NAME_TEST="omnilife"

# ASSISTANT_LLM_TIMEOUT_MS: Maximum timeout per individual Gemini SDK call in milliseconds (default: 20000)
ASSISTANT_LLM_TIMEOUT_MS=20000

# ASSISTANT_REQUEST_DEADLINE_MS: Total end-to-end deadline for an assistant chat request (default: 45000)
ASSISTANT_REQUEST_DEADLINE_MS=45000
